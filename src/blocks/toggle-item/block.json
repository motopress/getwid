{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"textdomain": "getwid",
	"name": "getwid/toggle-item",
	"category": "getwid-blocks",
	"title": "Toggle Item",
	"parent": [ "getwid/toggle" ],
	"supports": {
		"multiple": true,
		"reusable": false,
		"html": false
	},
	"attributes": {
		"outerParent": {
			"type": "object"
		},
		"title": {
			"type": "string",
			"source": "html",
			"selector": ".wp-block-getwid-toggle__header-title"
		},
		"active": {
			"type": "boolean",
			"default": false
		}
	},
	"editorScript": "file:./index.js"
}
