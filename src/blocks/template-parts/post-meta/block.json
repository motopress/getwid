{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "getwid/template-post-meta",
	"description": "Groups post metadata in one area.",
	"title": "Meta",
	"category": "getwid-post-blocks",
	"icon": "tagcloud",
	"textdomain": "getwid",
	"supports": {
		"inserter": true
	},
	"attributes": {
		"blockDivider": {
			"type": "string"
		},
		"textColor": {
			"type": "string"
		},
		"customTextColor": {
			"type": "string"
		},
		"direction": {
			"type": "string",
			"default": "row"
		},
		"textAlignment": {
			"type": "string"
		},
		"className": {
			"type": "string"
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css"
}
