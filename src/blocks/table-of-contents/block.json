{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"textdomain": "getwid",
	"name": "getwid/table-of-contents",
	"description": "Creates navigation from page headings.",
	"category": "getwid-blocks",
	"title": "Table of Contents",
	"keywords": [ "summary" ],
	"supports": {
		"multiple": false,
		"align": [ "left", "right", "wide", "full" ]
	},
	"attributes": {
		"headings": {
			"type": "array",
			"default": []
		},
		"allowedTags": {
			"type": "array",
			"default": [ false, true, true, true, true, true ]
		},
		"align": {
			"type": "string",
			"default": "none"
		},
		"listStyle": {
			"type": "string",
			"default": "default"
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
