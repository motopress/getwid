{
	"name": "getwid",
	"version": "1.6.10",
	"license": "GPL",
	"private": true,
	"scripts": {
		"start": "wp-scripts start --source-path=src/blocks --output-path=assets/blocks",
		"build": "wp-scripts build --source-path=src/blocks --output-path=assets/blocks",
		"start:components": "wp-scripts start --config webpack.components.js",
		"build:components": "wp-scripts build --config webpack.components.js",
		"lint:js": "wp-scripts lint-js \"src/**/*.{js,jsx,ts,tsx}\"",
		"format": "wp-scripts format \"src/**/*.{js,jsx,ts,tsx,scss,json}\""
	},
	"devDependencies": {
		"@types/jquery": "^4.0.0",
		"@types/wordpress__block-editor": "^15.0.6",
		"@wordpress/eslint-plugin": "^25.3.0",
		"@wordpress/scripts": "^32.3.0",
		"prettier": "npm:wp-prettier@^3.0.3",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@wordpress/block-editor": "^15.20.0",
		"@wordpress/blocks": "^15.20.0",
		"@wordpress/components": "^34.0.0",
		"@wordpress/data": "^10.47.0",
		"@wordpress/element": "^7.0.0",
		"@wordpress/i18n": "^6.20.0",
		"@wordpress/icons": "^13.2.0",
		"classnames": "^2.5.1",
		"clsx": "^2.1.1",
		"jquery": "^3.7.1",
		"mini-css-extract-plugin": "^2.10.2",
		"react-transition-group": "^4.4.5"
	}
}
